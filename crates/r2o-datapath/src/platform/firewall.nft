table inet r2o {
    comment "r2o-managed"
    set dns_route4 {
        type ipv4_addr . inet_proto . inet_service
        flags timeout
        size 64
    }
    set dns_route6 {
        type ipv6_addr . inet_proto . inet_service
        flags timeout
        size 64
    }
    set dns_h3_route4 {
        type ipv4_addr . inet_service . uid
        flags timeout
        size 64
    }
    set dns_h3_route6 {
        type ipv6_addr . inet_service . uid
        flags timeout
        size 64
    }
    chain dns_output {
        type filter hook output priority dstnat + 10; policy accept;
        meta mark @MARK@ return
        @MEASURE@
        oifname "lo" return
        ct status dnat return
        ip daddr . udp dport . meta skuid @dns_h3_route4 ct direction original ct original packets @WINDOW@ counter queue num @QUEUE4@ bypass
        ip6 daddr . udp dport . meta skuid @dns_h3_route6 ct direction original ct original packets @WINDOW@ counter queue num @QUEUE6@ bypass
        meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @dns_route4 ct direction original ct original packets @WINDOW@ counter queue num @QUEUE4@ bypass
        meta l4proto { tcp, udp } ip6 daddr . meta l4proto . th dport @dns_route6 ct direction original ct original packets @WINDOW@ counter queue num @QUEUE6@ bypass
    }
    chain out {
        type filter hook postrouting priority mangle; policy accept;
        ip saddr 127.0.0.0/8 return
        ip daddr 127.0.0.0/8 return
        ip6 saddr ::1 return
        ip6 daddr ::1 return
        meta nfproto ipv4 fib daddr type broadcast return
        ip daddr 224.0.0.0/4 return
        ip6 daddr ff00::/8 return
        meta mark @MARK@ return
        @MEASURE@
        ct status != dnat meta skuid 0-4294967294 meta l4proto { tcp, udp } ip daddr . meta l4proto . th dport @dns_route4 return
        ct status != dnat meta skuid 0-4294967294 meta l4proto { tcp, udp } ip6 daddr . meta l4proto . th dport @dns_route6 return
        ct status != dnat ip daddr . udp dport . meta skuid @dns_h3_route4 return
        ct status != dnat ip6 daddr . udp dport . meta skuid @dns_h3_route6 return
        ct status dnat return
@PLAIN_OUT@
        meta l4proto { tcp, udp } th dport { @DNS_PORTS@ } return
        @GATE_OUT@
        meta nfproto ipv4 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto udp th dport { @PORTS@ } ct direction original ct original packets @WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto udp th dport { @PORTS@ } ct direction original ct original packets @WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv4 meta l4proto udp th dport { @VOICE_PORTS@ } ct direction original ct original packets @VOICE_WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto udp th dport { @VOICE_PORTS@ } ct direction original ct original packets @VOICE_WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv4 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @LATE_WINDOW@ tcp flags & rst == rst queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @LATE_WINDOW@ tcp flags & fin == fin queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto tcp th dport { @HTTP_PORTS@ } ct direction original ct original packets @LATE_WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @LATE_WINDOW@ tcp flags & rst == rst queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto tcp th dport { @PORTS@ } ct direction original ct original packets @LATE_WINDOW@ tcp flags & fin == fin queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto tcp th dport { @HTTP_PORTS@ } ct direction original ct original packets @LATE_WINDOW@ queue num @QUEUE6@ bypass
    }
    chain in_rules {
        ip saddr 127.0.0.0/8 return
        ip daddr 127.0.0.0/8 return
        ip6 saddr ::1 return
        ip6 daddr ::1 return
        meta l4proto { tcp, udp } th sport { @DNS_PORTS@ } return
        ct status dnat return
        @GATE_IN@
        meta nfproto ipv4 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto udp th sport { @PORTS@ } ct direction reply ct reply packets @WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto udp th sport { @PORTS@ } ct direction reply ct reply packets @WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv4 meta l4proto udp th sport { @VOICE_PORTS@ } ct direction reply ct reply packets @VOICE_WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto udp th sport { @VOICE_PORTS@ } ct direction reply ct reply packets @VOICE_WINDOW@ queue num @QUEUE6@ bypass
        meta nfproto ipv4 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ tcp flags & rst == rst queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ tcp flags & fin == fin queue num @QUEUE4@ bypass
        meta nfproto ipv4 meta l4proto tcp th sport { @HTTP_PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ queue num @QUEUE4@ bypass
        meta nfproto ipv6 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ tcp flags & rst == rst queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto tcp th sport { @PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ tcp flags & fin == fin queue num @QUEUE6@ bypass
        meta nfproto ipv6 meta l4proto tcp th sport { @HTTP_PORTS@ } ct direction reply ct reply packets @LATE_WINDOW@ queue num @QUEUE6@ bypass
        icmp type time-exceeded icmp code 0 queue num @QUEUE4@ bypass
        icmpv6 type time-exceeded icmpv6 code 0 queue num @QUEUE6@ bypass
    }
    chain forward {
        type filter hook forward priority mangle; policy accept;
        jump in_rules
    }
    chain input {
        type filter hook input priority mangle; policy accept;
        ct status dnat return
@PLAIN_REPLY@
        iifname != "lo" ct status != dnat meta l4proto { tcp, udp } ip saddr . meta l4proto . th sport @dns_route4 ct direction reply ct reply packets @WINDOW@ counter queue num @QUEUE4@ bypass
        iifname != "lo" ct status != dnat meta l4proto { tcp, udp } ip6 saddr . meta l4proto . th sport @dns_route6 ct direction reply ct reply packets @WINDOW@ counter queue num @QUEUE6@ bypass
        jump in_rules
    }
    chain nat_post {
        type nat hook postrouting priority srcnat - 1; policy accept;
        meta nfproto ipv4 meta l4proto udp meta mark @MARK@ masquerade
    }
}
