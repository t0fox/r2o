#!/bin/sh /etc/rc.common
# OpenWrt host-side waiter; the Entware adapter owns application processes.
# shellcheck disable=SC2034 # rc.common reads these init-script fields
START=99
# shellcheck disable=SC2034 # rc.common reads these init-script fields
STOP=10
# shellcheck disable=SC2034 # rc.common reads these init-script fields
USE_PROCD=1

extra_command boot_wait 'Wait for /opt and boot R2O'
extra_command detach 'Cancel the boot waiter without stopping R2O'

recovery_interval() {
    r2o_recovery_interval=${R2O_RECOVERY_INTERVAL:-60}
    case "$r2o_recovery_interval" in
        ''|*[!0-9]*) r2o_recovery_interval=60 ;;
    esac
    if ! [ "$r2o_recovery_interval" -ge 1 ] 2>/dev/null || ! [ "$r2o_recovery_interval" -le 3600 ] 2>/dev/null; then
        r2o_recovery_interval=60
    fi
    printf '%s\n' "$r2o_recovery_interval"
}

start_service() {
    r2o_recovery_interval=$(recovery_interval)
    procd_open_instance boot
    procd_set_param command /bin/sh /etc/rc.common /etc/init.d/r2o boot_wait
    procd_set_param env "R2O_RECOVERY_INTERVAL=$r2o_recovery_interval"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

boot_wait() {
    unset LD_PRELOAD
    # shellcheck disable=SC3023 # procd uses fd 1000 for its service lock
    exec 1000>&-
    while [ ! -x /opt/etc/init.d/S99r2o ] || [ ! -x /opt/r2o/r2o-manager ] || [ ! -r /opt/r2o/config ]; do
        sleep 1
    done
    export PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
    r2o_recovery_interval=$(recovery_interval)
    /opt/etc/init.d/S99r2o start || true
    while :; do
        sleep "$r2o_recovery_interval" || return 1
        /opt/etc/init.d/S99r2o supervise >/dev/null 2>&1 || true
    done
}

detach() {
    procd_kill r2o 2>/dev/null
}

stop_service() {
    procd_kill r2o boot 2>/dev/null
    [ ! -x /opt/etc/init.d/S99r2o ] || /opt/etc/init.d/S99r2o stop
}

status_service() {
    [ ! -x /opt/etc/init.d/S99r2o ] || /opt/etc/init.d/S99r2o status
}
