#!/bin/sh /etc/rc.common
# OpenWrt host-side waiter; the Entware adapter owns application processes.
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance boot
    procd_set_param command /bin/sh /etc/rc.common /etc/init.d/r2o boot_wait
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

boot_wait() {
    unset LD_PRELOAD
    exec 1000>&-
    while [ ! -x /opt/etc/init.d/S99r2o ] || [ ! -x /opt/r2o/r2o-manager ] || [ ! -r /opt/r2o/config ]; do
        sleep 1
    done
    export PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin
    /opt/etc/init.d/S99r2o start
}

stop_service() {
    procd_kill r2o boot 2>/dev/null
    [ ! -x /opt/etc/init.d/S99r2o ] || /opt/etc/init.d/S99r2o stop
}

status_service() {
    [ ! -x /opt/etc/init.d/S99r2o ] || /opt/etc/init.d/S99r2o status
}
