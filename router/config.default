# Копировать только при первой установке; существующая конфигурация сохраняется при обновлении.
SCHEMA=1
MODE=apply
STATE_DIR=/opt/r2o/state
QUEUE_NUM=2000
QUEUE_NUM6=2001
R2O_FLOW_CAPACITY=2048
IPV6_ENABLED=1
MARK=45
PROBE_MARK=0
ONLY_MARK=
AUTOUPDATE=1
LOGMAX=2097152
LOGKEEP=1048576
LOG_EVERY=60
FW_BACKEND=auto
PORTS=0:65535
CONNBYTES=0:8
VOICE_PORTS=50000:50099,1400,3478:3481,5349,19294:19344
VOICE_CONNBYTES=0:4
HTTP_KEEPALIVE_PORTS=80
DNS_PORTS=53,853
PANEL_LISTEN=127.0.0.1:8090
TG_ENABLED=1
TG_MODE=local
TG_PORT=1443
R2O_PPE_DEOFFLOAD=1
